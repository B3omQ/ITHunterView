# ══════════════════════════════════════════════════════════════════
# ITHunterView — Production Environment Variables
# ══════════════════════════════════════════════════════════════════
# HƯỚNG DẪN:
#   1. Copy file này thành .env.prod: cp .env.prod.example .env.prod
#   2. Điền đầy đủ các giá trị bên dưới
#   3. KHÔNG bao giờ commit file .env.prod lên Git!
# ══════════════════════════════════════════════════════════════════

# ─── Domain (thay bằng domain thật của bạn) ───────────────────────
FRONTEND_URL=https://yourdomain.com
BACKEND_URL=https://api.yourdomain.com

# ─── Database ─────────────────────────────────────────────────────
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
DB_NAME=ithunterview

# ─── JWT (tạo chuỗi ngẫu nhiên, tối thiểu 32 ký tự) ──────────────
# Tạo bằng lệnh: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_VERY_LONG_RANDOM_SECRET_KEY_MIN_32_CHARS

# ─── Google OAuth ─────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ─── SMTP Email ───────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=no-reply@yourdomain.com

# ─── Cloudinary (upload ảnh/file) ─────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ─── AI Services ──────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
ASSEMBLY_AI_API_KEY=your-assemblyai-api-key
